set_prop(vendor_init, vendor_alarm_boot_prop)
set_prop(vendor_init, vendor_camera_prop)
set_prop(vendor_init, product_camera_prop)
set_prop(vendor_init, vendor_ssr_prop)
set_prop(vendor_init, vendor_video_prop)

allow vendor_init {
  proc_dirty
  proc
}:file w_file_perms;

allow vendor_init block_device:lnk_file setattr;

set_prop(vendor_init, vendor_fingerprint_prop)
set_prop(vendor_init, product_fingerprint_prop)
dontaudit vendor_init fingerprint_data_file:dir getattr;

set_prop(vendor_init, vendor_radio_prop)
set_prop(vendor_init, product_radio_prop)
set_prop(vendor_init, product_usb_prop)

allow vendor_init proc_sched:file write;
