allow init same_process_hal_file:file execute;

# init mounts spunvm during boot and must be able to unmount it cleanly during
# shutdown.  Without this, shutdown times out, kills tasks, and forces a reset.
allow init vendor_spunvm_file:filesystem unmount;

set_prop(init, vendor_fingerprint_prop)

allow init tmpfs:blk_file { getattr open read ioctl map relabelfrom };
allowxperm init tmpfs:blk_file ioctl { 0x1260-0x127f };

allow init vbmeta_block_device:blk_file { getattr open read ioctl map relabelto };
allow init vbmeta_block_device:lnk_file relabelto;
allowxperm init vbmeta_block_device:blk_file ioctl { 0x1260-0x127f };

dontaudit init sysfs:file setattr;

allow init adsprpcd_file:file mounton;

allow init sysfs_ufs_power:file { open write setattr };
