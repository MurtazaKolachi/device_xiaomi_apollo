r_dir_file(system_app, vendor_sysfs_battery_supply)

allow system_app zygote:unix_stream_socket getopt;
allow system_app user_profile_data_file:dir read;
allow system_app sysfs_zram:file { getattr open read };

# Allow XiaomiParts to access hardware HALs (Direct binder calls to avoid QCOM hal_client_domain neverallow bugs)
binder_call(system_app, hal_fingerprint_default)
binder_call(system_app, hal_audio_default)
binder_call(system_app, hal_health_default)
binder_call(system_app, hal_ir_default)
binder_call(system_app, hal_memtrack_default)
binder_call(system_app, hal_nfc_default)
binder_call(system_app, hal_power_default)
binder_call(system_app, vendor_hal_usb_qti)
binder_call(system_app, hal_vibrator_default)
binder_call(system_app, hal_wifi_default)
binder_call(system_app, hal_wifi_supplicant_default)
