dontaudit untrusted_app { 
    serialno_prop 
    oem_unlock_prop 
    userdebug_or_eng_prop 
    input_device 
    sysfs_net 
    proc_version
    mnt_sdcard_file
    system_lib_file
    proc_tty_drivers
    qemu_hw_prop
    qemu_sf_lcd_density_prop
    proc
    proc_net
    proc_pid_max
    proc_pressure_mem
    vendor_sysfs_soc
    build_bootimage_prop
}:file read;

dontaudit untrusted_app input_device:dir search;
dontaudit untrusted_app mnt_sdcard_file:lnk_file read;
dontaudit untrusted_app system_lib_file:file execmod;
dontaudit untrusted_app proc_net:file execmod;
dontaudit untrusted_app sysfs:dir read;
dontaudit untrusted_app block_device:dir search;

# Allow untrusted apps to find (enumerate) the OMAPI service
allow untrusted_app secure_element_service:service_manager find;
